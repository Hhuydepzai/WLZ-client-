<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.mojang.minecraftpe.preview" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.wlz.client.WlzApplication"
        android:allowBackup="false"
        android:icon="@drawable/wlz_icon"
        android:label="WLZ Client"
        android:roundIcon="@drawable/wlz_icon"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.wlz.client.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
